{
  "name": "template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "test": "jest",
    "start:dev": "ENVFILE=.env react-native start",
    "start:prod": "ENVFILE=.env.prod react-native start",
    "android:dev": "ENVFILE=.env react-native run-android --mode=devDebug --appId=com.template.dev",
    "android:prod": "ENVFILE=.env.prod react-native run-android --mode=prodDebug",
    "androidRelease:dev": "ENVFILE=.env cd android && ./gradlew assembleDevRelease && cd ..",
    "androidRelease:prod": "ENVFILE=.env.prod cd android && ./gradlew assembleProdRelease && cd ..",
    "ios:dev": "ENVFILE=.env react-native run-ios --scheme templateDev --mode Debug-Dev",
    "ios:prod": "ENVFILE=.env.prod react-native run-ios --scheme template --mode Release"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "moment": "^2.30.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-config": "^1.7.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.12.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
